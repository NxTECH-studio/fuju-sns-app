# -----------------------------------------------------------------------------
# Fuju App 環境変数テンプレート
# -----------------------------------------------------------------------------
# このファイルはドキュメントとして commit されています。
# 実際のビルドで参照されるのは以下のファイル:
#   - Android: リポジトリルートの `local.properties`
#             (キー名は `fuju.apiBaseUrl` / `fuju.authCoreBaseUrl` / `fuju.socialRedirectUri`)
#   - iOS:     `iosApp/Configuration/Config.xcconfig`
#             (`iosApp/Configuration/Config.xcconfig.example` をコピーして作る)
#
# 新規にクローンしたら下記の値を参考に上記 2 ファイルを作成してください。
# いずれも欠けた場合、Android 側は `androidApp/build.gradle.kts` の flavor 既定値に
# フォールバックします。
# -----------------------------------------------------------------------------

# AuthCore のベース URL。
#   Android エミュレータからホスト PC: http://10.0.2.2:8081
#   iOS Simulator からホスト PC:       http://localhost:8081
#   実機:                              LAN IP (例 http://192.168.1.10:8081) か staging URL
AUTH_CORE_BASE_URL=http://10.0.2.2:8081

# Fuju SNS Backend のベース URL。AuthCore と同じ要領でホスト名を書き分ける。
FUJU_API_BASE_URL=http://10.0.2.2:8080

# OAuth / ソーシャルログインのコールバック URI。
# `androidApp/AndroidManifest.xml` の intent-filter / iOS の URL Scheme と揃える。
SOCIAL_REDIRECT_URI=fuju://auth/callback

# 使用する flavor (Android: build variant, iOS: Xcode scheme)。
# dev / staging / prod のいずれか。単なるドキュメント用で、Gradle から参照はしない。
# FUJU_ENV=dev

# -----------------------------------------------------------------------------
# Android: `local.properties` への書き方 (キー名が異なる点に注意)
# -----------------------------------------------------------------------------
# sdk.dir=/home/<user>/Android/Sdk
# fuju.authCoreBaseUrl=http://10.0.2.2:8081
# fuju.apiBaseUrl=http://10.0.2.2:8080
# fuju.socialRedirectUri=fuju://auth/callback
